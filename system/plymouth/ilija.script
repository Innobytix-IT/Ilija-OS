# Ilija OS Plymouth Boot Theme
# Hintergrund: #0B1520 · Akzent: #E0A82E Gold · Text: #E6EEF5

Window.SetBackgroundTopColor    (0.044, 0.082, 0.125);
Window.SetBackgroundBottomColor (0.044, 0.082, 0.125);

sw = Window.GetWidth();
sh = Window.GetHeight();

# ── "Ilija OS" Label ───────────────────────────────────────────────────────────
label_img = Image.Text("Ilija OS", 0.902, 0.933, 0.961, 1.0);
label     = Sprite(label_img);
label.SetX(sw / 2 - label_img.GetWidth()  / 2);
label.SetY(sh / 2 + 44);
label.SetZ(2);

# ── Spinner: 8 rotierende Punkte in Gold ──────────────────────────────────────
n   = 8;
pi2 = 6.283185;
sr  = 22;
t   = 0;

for (i = 0; i < n; i++) {
    d_img[i] = Image.Text("•", 0.878, 0.659, 0.180, 1.0);
    d[i]     = Sprite(d_img[i]);
    d[i].SetZ(2);
}

fun refresh() {
    for (i = 0; i < n; i++) {
        angle = (i * pi2 / n) + (t * 0.10);
        d[i].SetX(sw / 2 + sr * Math.Cos(angle) - d_img[i].GetWidth()  / 2);
        d[i].SetY(sh / 2 + sr * Math.Sin(angle) - d_img[i].GetHeight() / 2);
        # Helligkeit: helle Seite läuft mit der Rotation mit
        s = Math.Sin(i * pi2 / n - t * 0.10);
        alpha = 0.18 + 0.82 * (s * 0.5 + 0.5);
        d[i].SetOpacity(alpha);
    }
    t++;
}

Plymouth.SetRefreshFunction(refresh);
