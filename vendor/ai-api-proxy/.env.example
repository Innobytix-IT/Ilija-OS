# ────────────────────────────────────────────────────────────────────────
#  Gemini Proxy — Konfiguration
# ────────────────────────────────────────────────────────────────────────

# Lokale API-Absicherung. Clients müssen diesen Wert als Bearer-Token
# oder X-API-Key-Header mitschicken. Leer / "change-me" = ungeschützt.
API_SECRET=change-me-to-a-random-string

# Server-Bind
HOST=0.0.0.0
PORT=8642

# ── Gemini API ──────────────────────────────────────────────────────────
# API-Key aus https://aistudio.google.com/apikey
# Der Proxy fragt beim Start automatisch models.list() ab und rotiert
# alle „agent-tauglichen" Modelle bei 429/503.
GEMINI_API_KEY=

# ── Modell-Filter ───────────────────────────────────────────────────────
# Kommagetrennte Substrings (case-insensitive). Modelle deren Name
# einen dieser Terme enthält werden aussortiert.
MODEL_EXCLUDE=embedding,aqa,-image,nano-banana,imagen,tts,transcribe,-live,native-audio,robotics,veo,lyria,antigravity,computer-use,deep-research,gemma,omni,-tuning

# Bevorzugtes Modell wenn Client "auto" oder gar nichts schickt.
# "auto" = Router wählt selbst (empfohlen).
DEFAULT_MODEL=auto

# ── Agent-Token-Optimierung ─────────────────────────────────────────────
# History-Pruning komprimiert ältere Tool-Outputs in langen Agent-Loops
# (behält Turn 1 + letzte N Nachrichten voll, kürzt mittlere).
ENABLE_AGENT_PRUNING=true
PRUNE_KEEP_RECENT=4
PRUNE_MAX_MIDDLE_CHARS=350
